# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real keys.

# Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never import outside server-only code (Server Actions / Route Handlers).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# PayPal Developer -> Apps & Credentials (use Sandbox during development)
# Client ID is safe to expose in frontend code — PayPal's own JS SDK requires it.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
# Secret is server-only — never expose to the browser.
PAYPAL_CLIENT_SECRET=your-paypal-secret
# Sandbox: https://api-m.sandbox.paypal.com — Live: https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
