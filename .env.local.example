# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real keys.

# Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never import outside server-only code (Server Actions / Route Handlers).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# PayPal Developer -> Apps & Credentials (use Sandbox during development)
# Client ID is safe to expose in frontend code — PayPal's own JS SDK requires it.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
# Secret is server-only — never expose to the browser.
PAYPAL_CLIENT_SECRET=your-paypal-secret
# Sandbox: https://api-m.sandbox.paypal.com — Live: https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# PayPal Developer -> your app -> Webhooks -> Add Webhook, pointing at
# https://yourdomain.com/api/webhooks/paypal (needs a real public URL, so
# this can't be set up until hosting is live). Subscribe to at least
# PAYMENT.CAPTURE.COMPLETED and PAYMENT.CAPTURE.DENIED. PayPal shows the
# Webhook ID after you create it.
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Brevo (newsletter) -> Settings -> SMTP & API -> API Keys. Server-only.
BREVO_API_KEY=your-brevo-api-key
# Brevo -> Contacts -> Lists -> the numeric ID of your subscribers list.
BREVO_LIST_ID=your-brevo-list-id
# Must be a sender verified in Brevo (Settings -> Senders & IP).
BREVO_SENDER_EMAIL=you@yourdomain.com

# Used to build absolute product links in newsletter emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret that authorizes calls to /api/cron/newsletter-digest.
# Make up a long random string. Whatever schedules the daily digest call
# (Supabase pg_cron, etc.) must send this as "Authorization: Bearer <value>"
# or "?secret=<value>".
CRON_SECRET=your-long-random-secret
